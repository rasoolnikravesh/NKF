<Project>
  <PropertyGroup>
    <!-- Package Metadata -->
    <Authors>Rasool Nikravesh</Authors>
    <Company>Nikravesh Framework</Company>
    <Copyright>Copyright © 2024 Nikravesh Framework Contributors</Copyright>
    <RepositoryUrl>https://github.com/rasoolnikravesh/NKF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rasoolnikravesh/NKF</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>ddd;domain-driven-design;cqrs;event-sourcing;mediatr;clean-architecture;nikravesh</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md</PackageReleaseNotes>
    <MinClientVersion>5.0.0</MinClientVersion>

    <!-- Documentation & Debugging -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Versioning (MinVer - auto from git tags) -->
    <Version>1.0.0</Version>

    <!-- Common Build -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- SourceLink for NuGet -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <!-- MinVer for automatic versioning from git tags -->
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Pack icon.png if exists at repo root -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../icon.png')">
    <None Include="$(MSBuildThisFileDirectory)../../icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../icon.png')">
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- MinVer Configuration -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>
</Project>